{
  "name": "minimarket-pos-android",
  "version": "1.0.0",
  "private": true,
  "description": "Minimarket POS — Android ilova (Capacitor). Veb-ilova ../docs papkasidan olinadi.",
  "scripts": {
    "copy-web": "node -e \"const fs=require('fs');fs.mkdirSync('www',{recursive:true});for(const f of ['index.html','manifest.webmanifest','icon-192.png','icon-512.png','favicon.png'])fs.copyFileSync('../docs/'+f,'www/'+f)\"",
    "sync": "npm run copy-web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-mlkit/barcode-scanning": "8.2.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
